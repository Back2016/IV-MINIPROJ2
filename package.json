{
  "name": "enso-weather-explorer",
  "productName": "ENSO Weather Explorer",
  "version": "0.1.3",
  "description": "MiniProj2: explore ENSO and US winter weather with linked D3 views",
  "author": "Yinkui Yu",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "test": "tsx --test tests/model.test.ts",
    "test:ui": "playwright test",
    "data": "python scripts/prepare_data.py"
  },
  "dependencies": {
    "d3": "7.9.0",
    "electron-squirrel-startup": "1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@playwright/test": "^1.56.0",
    "@types/d3": "^7.4.3",
    "electron": "44.7.2",
    "prettier": "3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
